# ============================================================
#   JoyedTiers — Complete Skript
#   Drop into plugins/Skript/scripts/ and set your password.
#   Everything else (tables, columns, schema) is automatic.
# ============================================================

options:
    # ── Only change these ──────────────────────────────────
    db_password: YOUR_PASSWORD_HERE
    region: US
    # ── Leave the rest alone ───────────────────────────────
    db_host: na01-sql.pebblehost.com
    db_port: 3306
    db_name: customer_1361378_JoyedTiers
    db_user: customer_1361378_JoyedTiers
    placement_fights: 10
    starting_mmr: 1000

# ============================================================
# DATABASE SETUP — runs every time the Skript loads.
# Creates tables and adds missing columns automatically.
# ============================================================
on skript load:
    set {jt.db} to connect to database "jdbc:mysql://{@db_host}:{@db_port}/{@db_name}?user={@db_user}&password={@db_password}&useSSL=false&allowPublicKeyRetrieval=true&autoReconnect=true"

    if {jt.db} is not set:
        broadcast "&c[JoyedTiers] &4Failed to connect to database! Check your password."
        stop

    # Create tables
    execute "CREATE TABLE IF NOT EXISTS players (uuid VARCHAR(36) NOT NULL PRIMARY KEY, username VARCHAR(16) NOT NULL, region VARCHAR(4) NOT NULL DEFAULT 'US', last_seen TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP)" in {jt.db}

    execute "CREATE TABLE IF NOT EXISTS player_stats (uuid VARCHAR(36) NOT NULL, mode VARCHAR(20) NOT NULL, mmr INT NOT NULL DEFAULT {@starting_mmr}, wins INT NOT NULL DEFAULT 0, losses INT NOT NULL DEFAULT 0, fights INT NOT NULL DEFAULT 0, PRIMARY KEY (uuid, mode))" in {jt.db}

    execute "CREATE TABLE IF NOT EXISTS ht1_holders (mode VARCHAR(20) NOT NULL PRIMARY KEY, uuid VARCHAR(36) NOT NULL, set_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP)" in {jt.db}

    # Add any missing columns (safe to run repeatedly — ADD COLUMN IF NOT EXISTS)
    execute "ALTER TABLE player_stats ADD COLUMN IF NOT EXISTS wins INT NOT NULL DEFAULT 0" in {jt.db}
    execute "ALTER TABLE player_stats ADD COLUMN IF NOT EXISTS losses INT NOT NULL DEFAULT 0" in {jt.db}
    execute "ALTER TABLE players ADD COLUMN IF NOT EXISTS region VARCHAR(4) NOT NULL DEFAULT 'US'" in {jt.db}

    # Stamp all players with this server's region
    execute "UPDATE players SET region = '{@region}'" in {jt.db}

    broadcast "&8[&6JoyedTiers&8] &aDatabase ready &7| Region: &b{@region} &7| Tables created/verified."


# ============================================================
# PLAYER TRACKING — register on join, update username
# ============================================================
on join:
    wait 1 tick
    set {_uuid} to uuid of player as text
    set {_name} to name of player

    execute "INSERT INTO players (uuid, username, region) VALUES ('%{_uuid}%', '%{_name}%', '{@region}') ON DUPLICATE KEY UPDATE username = '%{_name}%', region = '{@region}', last_seen = CURRENT_TIMESTAMP" in {jt.db}


# ============================================================
# CORE FUNCTIONS
# Call these from your arena / duel end events.
# ============================================================

# recordDuel(winner, loser, mode)
# Records win+1 for winner, loss+1 for loser, fights+1 for both.
# Then runs ELO update and checks for HT1 promotion.
# Example call: recordDuel(winner_player, loser_player, "sword")
function recordDuel(winner: player, loser: player, mode: text):
    set {_wu} to uuid of {_winner} as text
    set {_lu} to uuid of {_loser} as text
    set {_wname} to name of {_winner}
    set {_lname} to name of {_loser}

    # Ensure both players exist in DB
    execute "INSERT INTO players (uuid, username, region) VALUES ('%{_wu}%', '%{_wname}%', '{@region}') ON DUPLICATE KEY UPDATE username = '%{_wname}%'" in {jt.db}
    execute "INSERT INTO players (uuid, username, region) VALUES ('%{_lu}%', '%{_lname}%', '{@region}') ON DUPLICATE KEY UPDATE username = '%{_lname}%'" in {jt.db}

    # Ensure player_stats rows exist
    execute "INSERT IGNORE INTO player_stats (uuid, mode, mmr, wins, losses, fights) VALUES ('%{_wu}%', '%{_mode}%', {@starting_mmr}, 0, 0, 0)" in {jt.db}
    execute "INSERT IGNORE INTO player_stats (uuid, mode, mmr, wins, losses, fights) VALUES ('%{_lu}%', '%{_mode}%', {@starting_mmr}, 0, 0, 0)" in {jt.db}

    # Update wins/losses/fights
    execute "UPDATE player_stats SET wins = wins + 1, fights = fights + 1 WHERE uuid = '%{_wu}%' AND mode = '%{_mode}%'" in {jt.db}
    execute "UPDATE player_stats SET losses = losses + 1, fights = fights + 1 WHERE uuid = '%{_lu}%' AND mode = '%{_mode}%'" in {jt.db}

    # Fetch both MMRs for ELO calculation
    execute "SELECT mmr FROM player_stats WHERE uuid = '%{_wu}%' AND mode = '%{_mode}%'" in {jt.db}
    set {_rows::*} to last database result
    set {_wmmr} to {_rows::1::mmr} parsed as integer
    if {_wmmr} is not set:
        set {_wmmr} to {@starting_mmr}

    execute "SELECT mmr FROM player_stats WHERE uuid = '%{_lu}%' AND mode = '%{_mode}%'" in {jt.db}
    set {_rows2::*} to last database result
    set {_lmmr} to {_rows2::1::mmr} parsed as integer
    if {_lmmr} is not set:
        set {_lmmr} to {@starting_mmr}

    # ELO calculation (K=32)
    set {_k} to 32
    set {_expect_w} to 1 / (1 + 10 ^ (({_lmmr} - {_wmmr}) / 400.0))
    set {_expect_l} to 1 - {_expect_w}
    set {_new_wmmr} to floor({_wmmr} + {_k} * (1 - {_expect_w}))
    set {_new_lmmr} to floor({_lmmr} + {_k} * (0 - {_expect_l}))

    # Floor MMR at 100
    if {_new_wmmr} < 100:
        set {_new_wmmr} to 100
    if {_new_lmmr} < 100:
        set {_new_lmmr} to 100

    execute "UPDATE player_stats SET mmr = %{_new_wmmr}% WHERE uuid = '%{_wu}%' AND mode = '%{_mode}%'" in {jt.db}
    execute "UPDATE player_stats SET mmr = %{_new_lmmr}% WHERE uuid = '%{_lu}%' AND mode = '%{_mode}%'" in {jt.db}

    # Announce result in chat
    send "&8[&6%{_mode}%&8] &a%{_wname}% &7defeated &c%{_lname}% &8| &b+%floor({_k} * (1 - {_expect_w}))% MMR &8(%{_new_wmmr}%&8)" to {_winner}
    send "&8[&6%{_mode}%&8] &c%{_wname}% &7defeated you &8| &c-%floor({_k} * {_expect_l})% MMR &8(%{_new_lmmr}%&8)" to {_loser}

    # Check for HT1 promotion (highest MMR in this mode)
    checkHT1({_wu}, {_wname}, {_mode})


# checkHT1(uuid, username, mode)
# Checks if this player now has the highest MMR and should be HT1.
function checkHT1(uuid: text, username: text, mode: text):
    # Get the top MMR in this mode (placed players only)
    execute "SELECT uuid, mmr FROM player_stats WHERE mode = '%{_mode}%' AND fights >= {@placement_fights} ORDER BY mmr DESC LIMIT 1" in {jt.db}
    set {_rows::*} to last database result
    if size of {_rows::*} < 1:
        stop
    set {_top_uuid} to {_rows::1::uuid}
    if {_top_uuid} != {_uuid}:
        stop

    # This player is top — upsert into ht1_holders
    execute "INSERT INTO ht1_holders (mode, uuid) VALUES ('%{_mode}%', '%{_uuid}%') ON DUPLICATE KEY UPDATE uuid = '%{_uuid}%', set_at = CURRENT_TIMESTAMP" in {jt.db}
    broadcast "&8[&6JoyedTiers&8] &6&l%{_username}% &eis now &6&lHT1 &ein &b%{_mode}%&e!"


# setMMR(player, mode, mmr)
# Manually set a player's MMR (for admin use).
# Example: setMMR(player, "sword", 2500)
function setMMR(p: player, mode: text, mmr: integer):
    set {_uuid} to uuid of {_p} as text
    execute "UPDATE player_stats SET mmr = %{_mmr}% WHERE uuid = '%{_uuid}%' AND mode = '%{_mode}%'" in {jt.db}
    send "&8[&6JoyedTiers&8] &aMMR set to &b%{_mmr}% &ain &b%{_mode}%&a." to {_p}


# ============================================================
# ADMIN COMMANDS
# /joyedtiers reload — reconnects DB and re-runs setup
# /joyedtiers seths <player> <mode> — force-sets HT1
# ============================================================
command /joyedtiers [<text>] [<player>] [<text>]:
    permission: joyedtiers.admin
    trigger:
        if arg-1 is "reload":
            execute skript reload "JoyedTiers"
            send "&aJoyedTiers reloaded."

        else if arg-1 is "seths":
            if arg-2 is not set or arg-3 is not set:
                send "&cUsage: /joyedtiers seths <player> <mode>"
                stop
            set {_uuid} to uuid of arg-2 as text
            set {_name} to name of arg-2
            set {_mode} to arg-3
            execute "INSERT INTO ht1_holders (mode, uuid) VALUES ('%{_mode}%', '%{_uuid}%') ON DUPLICATE KEY UPDATE uuid = '%{_uuid}%', set_at = CURRENT_TIMESTAMP" in {jt.db}
            broadcast "&8[&6JoyedTiers&8] &6&l%{_name}% &ehas been set as &6&lHT1 &ein &b%{_mode}%&e!"

        else:
            send "&8[&6JoyedTiers&8] &7Commands: reload, seths <player> <mode>"
