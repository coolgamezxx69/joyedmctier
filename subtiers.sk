# ============================================================
#  GIVE KIT TO PLAYER — respects custom kit
# ============================================================

function subGiveKitToPlayer(p: player, mode: text):
    set {_uuid} to "%uuid of {_p}%"
    subClearForDuel({_p})
    if subHasCustomKit({_uuid}, {_mode}) is true:
        loop integers from 0 to 35:
            set {_item} to subGetCustomKitItem({_uuid}, {_mode}, loop-number)
            if {_item} is not air:
                set slot loop-number of {_p}'s inventory to {_item}
        subApplyDefaultArmourAndOffhand({_p}, {_mode})
    else:
        subGiveKit({_p}, {_mode})

# ============================================================
#  KIT EDITOR HELPERS
# ============================================================

function subHasCustomKit(uuid: text, mode: text) :: boolean:
    if {sub.editkit.%{_mode}%.%{_uuid}%.hasCustom} is true:
        return true
    return false

function subGetCustomKitItem(uuid: text, mode: text, slot: number) :: item:
    if {sub.editkit.%{_mode}%.%{_uuid}%.%{_slot}%} is set:
        return {sub.editkit.%{_mode}%.%{_uuid}%.%{_slot}%}
    return air

# ============================================================
#  GIVE KIT TO PLAYER — respects custom kit
# ============================================================
# ============================================================
#  KICK — same as quit, treated as disconnect
# ============================================================
on kick:
    if {sub.duel.pending::%player%} is set:
        delete {sub.duel.pending::%player%}
    delete {sub.duel.awaitingft::%player%}
    delete {sub.duel.pendingmode::%player%}
    delete {sub.duel.pendingopponent::%player%}

    if {sub.duel.active::%player%} is true:
        set {_loser}     to player
        set {_winner}    to {sub.duel.opponent::%player%}
        set {_arena}     to {sub.duel.arena::%player%}
        set {_arenaType} to {sub.duel.arenatype::%player%}
        set {_type}      to {sub.duel.type::%player%}

        if {_winner} is set:
            send "{@prefix} &e%{_loser}% &cwas kicked — &e%{_winner}% &awins the series!" to {_winner}
            subApplyDuelMMR({_winner}, {_loser}, {_type})
            subRestorePlayer({_winner})
            subCleanDuelVars({_winner})
            subCleanRoundVars({_winner})
            delete {sub.duel.inroundbreak::%{_winner}%}

        set {sub.duel.disconnected::%player%} to true

        delete {sub.duel.active::%player%}
        delete {sub.duel.opponent::%player%}
        delete {sub.duel.type::%player%}
        delete {sub.duel.arena::%player%}
        delete {sub.duel.arenatype::%player%}
        delete {sub.duel.inroundbreak::%player%}
        delete {sub.duel.roundwins::%player%}
        delete {sub.duel.ft::%player%}

        if {_arena} is set:
            if {_arenaType} is "big":
                delete {sub.arena.big.%{_arena}%.inuse}
            else:
                delete {sub.arena.small.%{_arena}%.inuse}

    call subLeaveAllQueues(player)
# ============================================================
#  ROUNDS HELPERS
# ============================================================

function subStartNextRound(p1: player, p2: player):
    set {_arena}     to {sub.duel.arena::%{_p1}%}
    set {_arenaType} to {sub.duel.arenatype::%{_p1}%}
    set {_mode}      to {sub.duel.type::%{_p1}%}
    set {_p1W}       to {sub.duel.roundwins::%{_p1}%}
    set {_p2W}       to {sub.duel.roundwins::%{_p2}%}
    set {_ft}        to {sub.duel.ft::%{_p1}%}

    if {_arenaType} is "big":
        set {_spawnP1} to {sub.arena.big.%{_arena}%.p1}
        set {_spawnP2} to {sub.arena.big.%{_arena}%.p2}
        resetBigArena({_arena})
    else:
        set {_spawnP1} to {sub.arena.small.%{_arena}%.p1}
        set {_spawnP2} to {sub.arena.small.%{_arena}%.p2}

    teleport {_p1} to {_spawnP1}
    teleport {_p2} to {_spawnP2}

    subGiveKitToPlayer({_p1}, {_mode})
    subGiveKitToPlayer({_p2}, {_mode})

    set {sub.duel.active::%{_p1}%} to true
    set {sub.duel.active::%{_p2}%} to true

    send "" to {_p1}
    send "&b&lRound starting! &7Score: &a%{_p1W}%&7-&c%{_p2W}% &7(FT%{_ft}%)" to {_p1}
    send "" to {_p1}
    send "" to {_p2}
    send "&b&lRound starting! &7Score: &a%{_p2W}%&7-&c%{_p1W}% &7(FT%{_ft}%)" to {_p2}
    send "" to {_p2}

# ============================================================
#  COMMAND: /deleteduelvariable
# ============================================================
command /deleteduelvariable:
    permission: op
    trigger:
        delete {sub.duel.request::%player%}
        
# ============================================================
#  COMMAND: /subduel <player>
# ============================================================
command /subduel <player>:
    trigger:
        if arg-1 is player:
            send "{@prefix} &cYou cannot duel yourself." to player
            stop
        if arg-1 is not online:
            send "{@prefix} &cPlayer not online." to player
            stop
        if {sub.duel.active::%arg-1%} is true:
            send "{@prefix} &cThat player is already in a sub duel." to player
            stop
        if {duel.active::%arg-1%} is true:
            send "{@prefix} &cThat player is already in a duel." to player
            stop
        if {sub.duel.pending::%arg-1%} is set:
            send "{@prefix} &cThat player already has a pending sub duel request." to player
            stop
        if {sub.duel.request::%player%} is set:
            send "{@prefix} &cYou already have a pending sub duel request." to player
            stop
        if {sub.duel.active::%player%} is true:
            send "{@prefix} &cYou are already in a sub duel." to player
            stop
        if {duel.active::%player%} is true:
            send "{@prefix} &cYou are already in a duel." to player
            stop

        set {sub.duel.request::%player%}  to arg-1
        set {sub.duel.pending::%arg-1%}   to player

        send "{@prefix} &e%arg-1% &ahas been sent a sub duel request by &e%player%&a." to player
        send "{@prefix} &e%player% &awants to sub duel you! Type &e/subacceptduel %player% &ato accept or &c/subdenyduel &cto deny." to arg-1

        wait 30 seconds

        if {sub.duel.pending::%arg-1%} is player:
            delete {sub.duel.pending::%arg-1%}
            delete {sub.duel.request::%player%}
            send "{@prefix} &cYour sub duel request to &e%arg-1% &chas expired." to player

# ============================================================
#  COMMAND: /subacceptduel <player>
# ============================================================
command /subacceptduel <player>:
    trigger:
        if {sub.duel.pending::%player%} is not set:
            send "{@prefix} &cYou have no pending sub duel request." to player
            stop
        if {sub.duel.pending::%player%} is not arg-1:
            send "{@prefix} &cYou don't have a pending sub duel request from &e%arg-1%&c." to player
            stop

        set {_requester} to {sub.duel.pending::%player%}

        if {_requester} is not online:
            send "{@prefix} &cThe player who challenged you is no longer online." to player
            delete {sub.duel.pending::%player%}
            stop
        if {sub.duel.active::%{_requester}%} is true:
            send "{@prefix} &cThat player is now in a sub duel." to player
            delete {sub.duel.pending::%player%}
            stop
        if {duel.active::%{_requester}%} is true:
            send "{@prefix} &cThat player is now in a duel." to player
            delete {sub.duel.pending::%player%}
            stop
        if {sub.duel.active::%player%} is true:
            send "{@prefix} &cYou are already in a sub duel." to player
            delete {sub.duel.pending::%player%}
            stop
        if {duel.active::%player%} is true:
            send "{@prefix} &cYou are already in a duel." to player
            delete {sub.duel.pending::%player%}
            stop

        delete {sub.duel.pending::%player%}

        set {_reqUUID} to "%uuid of {_requester}%"
        set {_accUUID} to "%uuid of player%"

        set {sub.duel.pendingopponent.uuid::%{_reqUUID}%} to {_accUUID}
        set {sub.duel.pendingopponent.uuid::%{_accUUID}%} to {_reqUUID}
        set {sub.duel.pendingopponent::%{_requester}%}    to player
        set {sub.duel.pendingopponent::%player%}          to {_requester}

        set {_gui} to chest inventory with 4 rows named "&bSub: Select Kit"

        set slot 11  of {_gui} to minecart with tnt named "&6CartPVP"
        set slot 12  of {_gui} to diamond sword named "&fSpeed"
        set slot 13  of {_gui} to bow named "&7Bow"
        set slot 14  of {_gui} to creeper spawn egg named "&2Creeper"
        set slot 15  of {_gui} to trident named "&3Trident"
        set slot 20  of {_gui} to elytra named "&bElytra"
        set slot 21  of {_gui} to diamond chestplate named "&9Diamond SMP"
        set slot 22  of {_gui} to diamond helmet named "&dDiamond Vanilla"
        set slot 8  of {_gui} to paper named "&eSet Round Count &7(click)"

        send "{@prefix} &e%player% &aaccepted the sub duel! Select a kit, then set a round count." to {_requester}
        send "{@prefix} &aSelect a kit, then set a round count for the sub duel!" to player

        open {_gui} to {_requester}
        set {sub.duel.setup::%{_requester}%} to true

# ============================================================
#  COMMAND: /subdenyduel
# ============================================================
command /subdenyduel:
    trigger:
        if {sub.duel.pending::%player%} is not set:
            send "{@prefix} &cYou have no pending sub duel request." to player
            stop

        set {_requester} to {sub.duel.pending::%player%}
        delete {sub.duel.pending::%player%}
        delete {sub.duel.request::%{_requester}%}

        send "{@prefix} &e%player% &cdenied your sub duel request." to {_requester}
        send "{@prefix} &cYou denied the sub duel request." to player

# ============================================================
#  COMMAND: /subendduel — forfeiter treated as loser
# ============================================================
command /subendduel:
    trigger:
        if {sub.duel.active::%player%} is not true:
            send "{@prefix} &cYou are not in a sub duel." to player
            stop

        set {_loser}     to player
        set {_winner}    to {sub.duel.opponent::%player%}
        set {_type}      to {sub.duel.type::%player%}
        set {_arena}     to {sub.duel.arena::%player%}
        set {_arenaType} to {sub.duel.arenatype::%player%}

        send "{@prefix} &e%{_loser}% &chas forfeited the sub duel." to {_loser}

        if {_winner} is a player:
            subApplyDuelMMR({_winner}, {_loser}, {_type})
            send "{@prefix} &e%{_loser}% &cforfeited — &e%{_winner}% &awins the series!" to {_winner}

        subRestorePlayer({_loser})
        subCleanDuelVars({_loser})
        subCleanRoundVars({_loser})

        if {_winner} is set:
            subRestorePlayer({_winner})
            subCleanDuelVars({_winner})
            subCleanRoundVars({_winner})

        if {_arena} is set:
            if {_arenaType} is "big":
                delete {sub.arena.big.%{_arena}%.inuse}
            else:
                delete {sub.arena.small.%{_arena}%.inuse}

# ============================================================
#  GUI INVENTORY CLOSE — Kit selection cancelled
# ============================================================
on inventory close:
    if name of event-inventory is "&bSub: Select Kit":
        if {sub.duel.setup::%player%} is true:
            delete {sub.duel.setup::%player%}
            if {sub.duel.awaitingft::%player%} is true:
                stop
            set {_p2} to {sub.duel.pendingopponent::%player%}
            delete {sub.duel.pendingmode::%player%}
            if {_p2} is set:
                set {_myUUID}  to "%uuid of player%"
                set {_oppUUID} to "%uuid of {_p2}%"
                delete {sub.duel.pendingopponent::%player%}
                delete {sub.duel.pendingopponent::%{_p2}%}
                delete {sub.duel.pendingopponent.uuid::%{_myUUID}%}
                delete {sub.duel.pendingopponent.uuid::%{_oppUUID}%}
                delete {sub.duel.request::%player%}
                if {_p2} is online:
                    send "{@prefix} &e%player% &cclosed the kit selection — sub duel cancelled." to {_p2}
            send "{@prefix} &cSub duel cancelled — you closed the kit selection menu." to player

# ============================================================
#  GUI CLICK — Kit selection
# ============================================================
on inventory click:
    if name of event-inventory is "&bSub: Select Kit":
        cancel event
        if event-item is air:
            stop
        set {_p1} to player
        set {_p2} to {sub.duel.pendingopponent::%player%}
        if {_p2} is not set:
            send "{@prefix} &cSub duel setup error — opponent not found." to {_p1}
            close {_p1}'s inventory
            stop
        if {_p2} is not online:
            send "{@prefix} &cPlayer went offline." to {_p1}
            set {_p1UUID} to "%uuid of {_p1}%"
            set {_p2UUID} to "%uuid of {_p2}%"
            delete {sub.duel.pendingopponent::%{_p1}%}
            delete {sub.duel.pendingopponent.uuid::%{_p1UUID}%}
            delete {sub.duel.pendingopponent.uuid::%{_p2UUID}%}
            close {_p1}'s inventory
            stop
        if {sub.duel.active::%{_p1}%} is true:
            close {_p1}'s inventory
            stop
        if {sub.duel.active::%{_p2}%} is true:
            send "{@prefix} &cThe other player is already in a sub duel." to {_p1}
            close {_p1}'s inventory
            stop
        set {_n} to name of event-item
        if {_n} is "&6CartPVP":
            set {sub.duel.pendingmode::%{_p1}%} to "cartpvp"
            send "{@prefix} &aKit: &6CartPVP &7selected. Now set the round count." to {_p1}
            stop
        else if {_n} is "&fSpeed":
            set {sub.duel.pendingmode::%{_p1}%} to "speed"
            send "{@prefix} &aKit: &fSpeed &7selected. Now set the round count." to {_p1}
            stop
        else if {_n} is "&7Bow":
            set {sub.duel.pendingmode::%{_p1}%} to "bow"
            send "{@prefix} &aKit: &7Bow &7selected. Now set the round count." to {_p1}
            stop
        else if {_n} is "&2Creeper":
            set {sub.duel.pendingmode::%{_p1}%} to "creeper"
            send "{@prefix} &aKit: &2Creeper &7selected. Now set the round count." to {_p1}
            stop
        else if {_n} is "&3Trident":
            set {sub.duel.pendingmode::%{_p1}%} to "trident"
            send "{@prefix} &aKit: &3Trident &7selected. Now set the round count." to {_p1}
            stop
        else if {_n} is "&bElytra":
            set {sub.duel.pendingmode::%{_p1}%} to "elytra"
            send "{@prefix} &aKit: &bElytra &7selected. Now set the round count." to {_p1}
            stop
        else if {_n} is "&9Diamond SMP":
            set {sub.duel.pendingmode::%{_p1}%} to "diamondsmp"
            send "{@prefix} &aKit: &9Diamond SMP &7selected. Now set the round count." to {_p1}
            stop
        else if {_n} is "&dDiamond Vanilla":
            set {sub.duel.pendingmode::%{_p1}%} to "diamondvanilla"
            send "{@prefix} &aKit: &dDiamond Vanilla &7selected. Now set the round count." to {_p1}
            stop
        else if {_n} is "&eSet Round Count &7(click)":
            if {sub.duel.pendingmode::%{_p1}%} is not set:
                send "{@prefix} &cSelect a kit first." to {_p1}
                stop
            set {sub.duel.awaitingft::%{_p1}%} to true
            delete {sub.duel.setup::%player%}
            close {_p1}'s inventory
            send "{@prefix} &eType a number &7(1-15) &ein chat to set the round count. Type &ccancel &eto abort." to {_p1}
            stop

# ============================================================
#  CHAT — FT input + admin /subsetmmr input
# ============================================================
on chat:
    if {sub.duel.awaitingft::%player%} is true:
        cancel event

        if message is "cancel":
            delete {sub.duel.awaitingft::%player%}
            delete {sub.duel.pendingmode::%player%}
            set {_myUUID}  to "%uuid of player%"
            set {_oppUUID} to {sub.duel.pendingopponent.uuid::%{_myUUID}%}
            if {_oppUUID} is set:
                set {_opp} to {sub.duel.pendingopponent::%player%}
                delete {sub.duel.pendingopponent::%player%}
                delete {sub.duel.pendingopponent.uuid::%{_myUUID}%}
                delete {sub.duel.pendingopponent.uuid::%{_oppUUID}%}
                if {_opp} is set:
                    if {_opp} is online:
                        delete {sub.duel.pendingopponent::%{_opp}%}
                        send "{@prefix} &e%player% &ccancelled the sub duel setup." to {_opp}
            send "{@prefix} &cSub duel setup cancelled." to player
            stop

        set {_p1}     to player
        set {_myUUID} to "%uuid of {_p1}%"

        set {_oppUUID} to {sub.duel.pendingopponent.uuid::%{_myUUID}%}
        if {_oppUUID} is not set:
            delete {sub.duel.awaitingft::%{_p1}%}
            delete {sub.duel.pendingmode::%{_p1}%}
            send "{@prefix} &cOpponent data lost — sub duel cancelled." to {_p1}
            stop

        set {_p2} to {sub.duel.pendingopponent::%{_p1}%}
        if {_p2} is not set:
            delete {sub.duel.awaitingft::%{_p1}%}
            delete {sub.duel.pendingmode::%{_p1}%}
            delete {sub.duel.pendingopponent.uuid::%{_myUUID}%}
            delete {sub.duel.pendingopponent.uuid::%{_oppUUID}%}
            send "{@prefix} &cPlayer went offline." to {_p1}
            stop
        if {_p2} is not online:
            delete {sub.duel.awaitingft::%{_p1}%}
            delete {sub.duel.pendingmode::%{_p1}%}
            delete {sub.duel.pendingopponent::%{_p1}%}
            delete {sub.duel.pendingopponent.uuid::%{_myUUID}%}
            delete {sub.duel.pendingopponent.uuid::%{_oppUUID}%}
            send "{@prefix} &cPlayer went offline." to {_p1}
            stop
        if {sub.duel.pendingmode::%{_p1}%} is not set:
            delete {sub.duel.awaitingft::%{_p1}%}
            delete {sub.duel.pendingopponent::%{_p1}%}
            delete {sub.duel.pendingopponent.uuid::%{_myUUID}%}
            delete {sub.duel.pendingopponent.uuid::%{_oppUUID}%}
            send "{@prefix} &cKit was deselected — please start over." to {_p1}
            stop

        set {_ft} to message parsed as integer
        if {_ft} is not set:
            send "{@prefix} &cInvalid number — type a number between 1 and 15." to {_p1}
            stop
        if {_ft} < 1:
            send "{@prefix} &cMinimum round count is 1." to {_p1}
            stop
        if {_ft} > 15:
            send "{@prefix} &cMaximum round count is 15." to {_p1}
            stop

        # All validated — clean up pending state
        delete {sub.duel.awaitingft::%{_p1}%}
        set {_mode} to {sub.duel.pendingmode::%{_p1}%}
        delete {sub.duel.pendingmode::%{_p1}%}
        delete {sub.duel.pendingopponent::%{_p1}%}
        delete {sub.duel.pendingopponent::%{_p2}%}
        delete {sub.duel.pendingopponent.uuid::%{_myUUID}%}
        delete {sub.duel.pendingopponent.uuid::%{_oppUUID}%}
        delete {sub.duel.request::%{_p1}%}

        # ── ARENA ASSIGNMENT ──────────────────────────────────
        if {_mode} is "elytra" or "cartpvp" or "trident" or "diamondsmp" or "diamondvanilla" or "creeper":
            set {_arenaIdx} to subGetFreeBigArena()
            if {_arenaIdx} is 0:
                send "{@prefix} &cAll big arenas are in use. Please wait." to {_p1}
                stop
            set {_arenaType} to "big"
            set {sub.arena.big.%{_arenaIdx}%.inuse} to true
            set {_spawnP1} to {sub.arena.big.%{_arenaIdx}%.p1}
            set {_spawnP2} to {sub.arena.big.%{_arenaIdx}%.p2}
        else:
            set {_arenaIdx} to subGetFreeSmallArena()
            if {_arenaIdx} is 0:
                send "{@prefix} &cAll arenas are in use. Please wait." to {_p1}
                stop
            set {_arenaType} to "small"
            set {sub.arena.small.%{_arenaIdx}%.inuse} to true
            set {_spawnP1} to {sub.arena.small.%{_arenaIdx}%.p1}
            set {_spawnP2} to {sub.arena.small.%{_arenaIdx}%.p2}

        # ── LINK OPPONENTS ────────────────────────────────────
        set {sub.duel.opponent::%{_p1}%}   to {_p2}
        set {sub.duel.opponent::%{_p2}%}   to {_p1}
        set {sub.duel.type::%{_p1}%}       to {_mode}
        set {sub.duel.type::%{_p2}%}       to {_mode}
        set {sub.duel.arena::%{_p1}%}      to {_arenaIdx}
        set {sub.duel.arena::%{_p2}%}      to {_arenaIdx}
        set {sub.duel.arenatype::%{_p1}%}  to {_arenaType}
        set {sub.duel.arenatype::%{_p2}%}  to {_arenaType}
        set {sub.duel.ft::%{_p1}%}         to {_ft}
        set {sub.duel.ft::%{_p2}%}         to {_ft}
        set {sub.duel.roundwins::%{_p1}%}  to 0
        set {sub.duel.roundwins::%{_p2}%}  to 0

        subSaveDuelState({_p1}, {_p2})
        subClearForDuel({_p1})
        subClearForDuel({_p2})

        teleport {_p1} to {_spawnP1}
        teleport {_p2} to {_spawnP2}

        if {_arenaType} is "big":
            resetBigArena({_arenaIdx})

        wait 5 ticks

        subGiveKitToPlayer({_p1}, {_mode})
        subGiveKitToPlayer({_p2}, {_mode})

        set {sub.duel.active::%{_p1}%} to true
        set {sub.duel.active::%{_p2}%} to true
        heal {_p1}
        heal {_p2}
        execute console command "effect clear %{_p1}%"
        execute console command "effect clear %{_p2}%"

        send "{@prefix} &aThe sub duel has started! &7(FT%{_ft}%) Use &e/subendduel &ato forfeit." to {_p1}
        send "{@prefix} &aThe sub duel has started! &7(FT%{_ft}%) Use &e/subendduel &ato forfeit." to {_p2}

    # ── Admin /subsetmmr chat input ────────────────────────────
    if {sub.setmmr.awaiting::%player%} is true:
        cancel event
        if message is "cancel":
            delete {sub.setmmr.awaiting::%player%}
            delete {sub.setmmr.mode::%player%}
            delete {sub.setmmr.target::%player%}
            send "&cCancelled." to player
            stop
        set {_input} to message parsed as integer
        if {_input} is not set:
            send "&cInvalid amount. Type a number or &ecancel&c." to player
            stop
        if {_input} < 0:
            send "&cAmount cannot be negative." to player
            stop
        if {_input} > 9999:
            send "&cAmount cannot exceed 9999." to player
            stop
        set {_target} to {sub.setmmr.target::%player%}
        set {_mode}   to {sub.setmmr.mode::%player%}
        set {_uuid}   to "%uuid of {_target}%"
        set {sub.mmr.%{_mode}%::%{_uuid}%} to {_input}
        set {sub.mmr.lastfight.%{_mode}%::%{_uuid}%} to now
        if {sub.fights.%{_mode}%::%{_uuid}%} is not set:
            set {sub.fights.%{_mode}%::%{_uuid}%} to 10
        else if {sub.fights.%{_mode}%::%{_uuid}%} < 10:
            set {sub.fights.%{_mode}%::%{_uuid}%} to 10
        send "&aSet &e%name of {_target}%&a's &f%{_mode}%&a MMR to &f%{_input}%&a." to player
        send "&b[SubDuels] &7An admin set your &f%{_mode}%&7 MMR to &f%{_input}%&7." to {_target}
        delete {sub.setmmr.awaiting::%player%}
        delete {sub.setmmr.mode::%player%}
        delete {sub.setmmr.target::%player%}

# ============================================================
#  ACTION BAR
# ============================================================
every 4 ticks:
    loop all players:
        if {sub.duel.active::%loop-player%} is true:
            set {_p}      to loop-player
            set {_opp}    to {sub.duel.opponent::%{_p}%}
            if {_opp} is not set:
                stop
            set {_myHp}    to health of {_p}
            set {_oppHp}   to health of {_opp}
            set {_myAbs}   to absorption amount of {_p} / 2
            set {_oppAbs}  to absorption amount of {_opp} / 2
            set {_myWins}  to {sub.duel.roundwins::%{_p}%}
            set {_oppWins} to {sub.duel.roundwins::%{_opp}%}
            set {_ft}      to {sub.duel.ft::%{_p}%}
            if {_myWins} is not set:
                set {_myWins} to 0
            if {_oppWins} is not set:
                set {_oppWins} to 0
            set {_myDisplay}  to "&c%{_myHp}%&7/&c20"
            set {_oppDisplay} to "&c%{_oppHp}%&7/&c20"
            if {_myAbs} > 0:
                set {_myDisplay}  to "%{_myDisplay}% &e(+%{_myAbs}%)"
            if {_oppAbs} > 0:
                set {_oppDisplay} to "%{_oppDisplay}% &e(+%{_oppAbs}%)"
            send action bar "&aYou: %{_myDisplay}% &7[&a%{_myWins}%&7-&c%{_oppWins}%&7] FT%{_ft}%  &7|  &a%{_opp}%: %{_oppDisplay}%" to {_p}

# ============================================================
#  DEATH (DUEL) — round logic, MMR only on series win
# ============================================================
on death:
    if {sub.duel.active::%victim%} is true:
        clear drops
        set {_loser}     to victim
        set {_winner}    to {sub.duel.opponent::%{_loser}%}
        set {_type}      to {sub.duel.type::%{_loser}%}
        set {_arena}     to {sub.duel.arena::%{_loser}%}
        set {_arenaType} to {sub.duel.arenatype::%{_loser}%}
        set {_ft}        to {sub.duel.ft::%{_loser}%}

        delete {sub.duel.active::%{_loser}%}

        # ── TIE CHECK ─────────────────────────────────────────
        if {sub.duel.active::%{_winner}%} is not true:
            send "{@prefix} &eIt's a tie! Both players died at the same time." to {_loser}
            if {_winner} is online:
                send "{@prefix} &eIt's a tie! Both players died at the same time." to {_winner}
            if {_arena} is set:
                if {_arenaType} is "big":
                    delete {sub.arena.big.%{_arena}%.inuse}
                else:
                    delete {sub.arena.small.%{_arena}%.inuse}
            subCleanDuelVars({_loser})
            subCleanRoundVars({_loser})
            set {sub.duel.loser::%{_loser}%} to true
            if {_winner} is online:
                set {sub.duel.pendingwin::%{_winner}%} to true
            stop

        # ── ROUND WIN ─────────────────────────────────────────
        delete {sub.duel.active::%{_winner}%}
        add 1 to {sub.duel.roundwins::%{_winner}%}

        set {_wWins} to {sub.duel.roundwins::%{_winner}%}
        set {_lWins} to {sub.duel.roundwins::%{_loser}%}

        # ── SERIES OVER? ──────────────────────────────────────
        if {_wWins} >= {_ft}:
            send "{@prefix} &e%{_winner}% &awon the series &a(%{_wWins}%-%{_lWins}%) against &e%{_loser}%&a!" to {_winner}
            send "{@prefix} &cYou lost the series &7(%{_lWins}%-%{_wWins}%) against &e%{_winner}%&c!" to {_loser}

            if {_winner} is a player:
                if {_loser} is a player:
                    subApplyDuelMMR({_winner}, {_loser}, {_type})

            if {_arena} is set:
                if {_arenaType} is "big":
                    delete {sub.arena.big.%{_arena}%.inuse}
                else:
                    delete {sub.arena.small.%{_arena}%.inuse}

            subCleanRoundVars({_winner})
            subCleanRoundVars({_loser})
            set {sub.duel.loser::%{_loser}%}      to true
            set {sub.duel.pendingwin::%{_winner}%} to true

        else:
            # ── NEXT ROUND ────────────────────────────────────
            send "" to {_winner}
            send "&6&lRound over! &e%{_winner}% &awon that round. &7Score: &a%{_wWins}%&7-&c%{_lWins}% &7(FT%{_ft}%)" to {_winner}
            send "" to {_winner}
            send "" to {_loser}
            send "&6&lRound over! &e%{_winner}% &awon that round. &7Score: &a%{_wWins}%&7-&c%{_lWins}% &7(FT%{_ft}%)" to {_loser}
            send "" to {_loser}
            heal {_winner}
            execute console command "effect clear %{_winner}%"
            set {sub.duel.inroundbreak::%{_winner}%} to true
            set {sub.duel.inroundbreak::%{_loser}%}  to true
            set {sub.duel.loser::%{_loser}%}          to true
            set {sub.duel.pendingwin::%{_winner}%}    to true

            loop 5 times:
                set {_countdown} to 6 - loop-number
                wait 20 ticks
                if {_winner} is online:
                    send action bar "&eNext round in &c%{_countdown}%&e..." to {_winner}
                if {_loser} is online:
                    send action bar "&eNext round in &c%{_countdown}%&e..." to {_loser}

            if {_winner} is online:
                if {_loser} is online:
                    delete {sub.duel.inroundbreak::%{_winner}%}
                    delete {sub.duel.inroundbreak::%{_loser}%}
                    delete {sub.duel.loser::%{_loser}%}
                    delete {sub.duel.pendingwin::%{_winner}%}
                    subStartNextRound({_winner}, {_loser})
                else:
                    send "{@prefix} &cYour opponent disconnected — you win the series!" to {_winner}
                    subApplyDuelMMR({_winner}, {_loser}, {_type})
                    if {_arena} is set:
                        if {_arenaType} is "big":
                            delete {sub.arena.big.%{_arena}%.inuse}
                        else:
                            delete {sub.arena.small.%{_arena}%.inuse}
                    subRestorePlayer({_winner})
                    subCleanDuelVars({_winner})
                    subCleanRoundVars({_winner})
                    delete {sub.duel.inroundbreak::%{_winner}%}
                    delete {sub.duel.pendingwin::%{_winner}%}

every 3 ticks:
    loop all players:
        if {sub.duel.pendingwin::%loop-player%} is true:
            if {sub.duel.inroundbreak::%loop-player%} is not true:
                delete {sub.duel.pendingwin::%loop-player%}
                subRestorePlayer(loop-player)
                subCleanDuelVars(loop-player)

# ============================================================
#  RESPAWN — loser restore
# ============================================================
on respawn:
    if {sub.duel.loser::%player%} is true:
        if {sub.duel.inroundbreak::%player%} is true:
            wait 2 ticks
            heal player
            feed player
            stop
        wait 2 ticks
        subRestorePlayer(player)
        subCleanDuelVars(player)
        subCleanRoundVars(player)
        delete {sub.duel.loser::%player%}

# ============================================================
#  QUIT — disconnecter treated as loser (series ends)
# ============================================================
on quit:
    if {sub.duel.pending::%player%} is set:
        delete {sub.duel.pending::%player%}
    delete {sub.duel.awaitingft::%player%}
    delete {sub.duel.pendingmode::%player%}
    delete {sub.duel.pendingopponent::%player%}

    if {sub.duel.active::%player%} is true:
        set {_loser}     to player
        set {_winner}    to {sub.duel.opponent::%player%}
        set {_arena}     to {sub.duel.arena::%player%}
        set {_arenaType} to {sub.duel.arenatype::%player%}
        set {_type}      to {sub.duel.type::%player%}

        if {_winner} is set:
            send "{@prefix} &e%{_loser}% &cleft — &e%{_winner}% &awins the series!" to {_winner}
            subApplyDuelMMR({_winner}, {_loser}, {_type})
            subRestorePlayer({_winner})
            subCleanDuelVars({_winner})
            subCleanRoundVars({_winner})
            delete {sub.duel.inroundbreak::%{_winner}%}

        set {sub.duel.disconnected::%player%} to true

        delete {sub.duel.active::%player%}
        delete {sub.duel.opponent::%player%}
        delete {sub.duel.type::%player%}
        delete {sub.duel.arena::%player%}
        delete {sub.duel.arenatype::%player%}
        delete {sub.duel.inroundbreak::%player%}
        delete {sub.duel.roundwins::%player%}
        delete {sub.duel.ft::%player%}

        if {_arena} is set:
            if {_arenaType} is "big":
                delete {sub.arena.big.%{_arena}%.inuse}
            else:
                delete {sub.arena.small.%{_arena}%.inuse}

    # Leave queues on quit
    call subLeaveAllQueues(player)

# ============================================================
#  REJOIN — restore disconnected player's inventory
# ============================================================
on join:
    if {sub.duel.disconnected::%player%} is true:
        delete {sub.duel.disconnected::%player%}
        clear player's inventory
        set player's helmet      to air
        set player's chestplate  to air
        set player's leggings    to air
        set player's boots       to air
        set player's offhand tool to air
        loop 36 times:
            set slot (loop-number - 1) of player's inventory to {sub.saved.inv.%player%.%loop-number - 1%}
        delete {sub.saved.inv.%player%::*}
        set player's helmet      to {sub.saved.armor.helmet::%player%}
        set player's chestplate  to {sub.saved.armor.chestplate::%player%}
        set player's leggings    to {sub.saved.armor.leggings::%player%}
        set player's boots       to {sub.saved.armor.boots::%player%}
        set player's offhand tool to {sub.saved.armor.offhand::%player%}
        delete {sub.saved.armor.helmet::%player%}
        delete {sub.saved.armor.chestplate::%player%}
        delete {sub.saved.armor.leggings::%player%}
        delete {sub.saved.armor.boots::%player%}
        delete {sub.saved.armor.offhand::%player%}
        teleport player to {sub.duel.pos::%player%}
        delete {sub.duel.pos::%player%}
        delete {sub.duel.loser::%player%}
        send "{@prefix} &cYour sub duel was ended because you disconnected." to player

    else if {sub.duel.active::%player%} is true:
        clear player's inventory
        set player's helmet      to air
        set player's chestplate  to air
        set player's leggings    to air
        set player's boots       to air
        set player's offhand tool to air
        loop 36 times:
            set slot (loop-number - 1) of player's inventory to {sub.saved.inv.%player%.%loop-number - 1%}
        delete {sub.saved.inv.%player%::*}
        set player's helmet      to {sub.saved.armor.helmet::%player%}
        set player's chestplate  to {sub.saved.armor.chestplate::%player%}
        set player's leggings    to {sub.saved.armor.leggings::%player%}
        set player's boots       to {sub.saved.armor.boots::%player%}
        set player's offhand tool to {sub.saved.armor.offhand::%player%}
        delete {sub.saved.armor.helmet::%player%}
        delete {sub.saved.armor.chestplate::%player%}
        delete {sub.saved.armor.leggings::%player%}
        delete {sub.saved.armor.boots::%player%}
        delete {sub.saved.armor.offhand::%player%}
        teleport player to {sub.duel.pos::%player%}
        delete {sub.duel.pos::%player%}
        subCleanDuelVars(player)
        subCleanRoundVars(player)
        delete {sub.duel.loser::%player%}
        send "{@prefix} &cYour sub duel was ended because you disconnected." to player

# ============================================================
#  COMMAND: /subrank [player]
# ============================================================
command /subrank [<player>]:
    trigger:
        if arg 1 is set:
            set {_target} to arg 1
        else:
            set {_target} to player
        set {_uuid}         to "%uuid of {_target}%"
        set {_totalMMR}     to subGetTotalMMR({_uuid})
        set {_totalPoints}  to subGetTotalPoints({_uuid})
        set {_overallPos}   to subGetOverallRank({_uuid})

        send "" to player
        send "&8&m               &b&l%name of {_target}%'s Sub Ranks &8&m              " to player
        send "" to player
        if {_totalMMR} is 0:
            send "&7Overall Rank: &8Unranked &7(complete placements in any mode to rank)" to player
            send "&7Ranking Points: &80" to player
        else:
            send "&7Overall Rank: &6#%{_overallPos}% &8| &7Total MMR: &f%{_totalMMR}%" to player
            send "&7Ranking Points: &6%{_totalPoints}% pts" to player
        send "" to player
        send "&b&lGamemode MMR:" to player

        loop "cartpvp", "speed", "bow", "creeper", "trident", "elytra", "diamondsmp", "diamondvanilla":
            set {_mmr}    to subGetModeMMR({_target}, loop-value)
            set {_fights} to subGetModeFights({_target}, loop-value)
            set {_rank}   to subGetModeRank({_uuid}, loop-value)
            set {_name}   to subGetQueueModeName(loop-value)
            if {_rank} is "Unranked":
                send "  &7%{_name}%: &8Unranked &7(%{_fights}%/10 placements)" to player
            else:
                send "  &7%{_name}%: &f%{_rank}% &8(%{_mmr}% MMR, %{_fights}% fights)" to player

        send "" to player

# ============================================================
#  COMMAND: /subht1 [mode]
# ============================================================
command /subht1 [<text>]:
    trigger:
        if arg 1 is set:
            set {_mode} to arg 1
            if {sub.ht1holder.%{_mode}%} is not set:
                send "{@prefix} &7No HT1 holder yet in &f%{_mode}%&7." to player
                stop
            send "{@prefix} &6&l[HT1 - %{_mode}%] &eCurrent champion: &6%{sub.ht1holder.%{_mode}%}%" to player
        else:
            send "{@prefix} &7Usage: /subht1 <mode>  (cartpvp, speed, bow, creeper, trident, elytra, diamondsmp, diamondvanilla)" to player

# ============================================================
#  ADMIN: /subsetmmr <player>
# ============================================================
command /subsetmmr <player>:
    permission: op
    trigger:
        if arg-1 is not set:
            send "&cUsage: /subsetmmr <player>" to player
            stop
        set {sub.setmmr.target::%player%} to arg-1
        set {_gui} to chest inventory with 1 rows named "&8Sub: Set MMR"
        set slot 0 of {_gui} to minecart with tnt named "&6CartPVP"
        set slot 1 of {_gui} to diamond sword named "&fSpeed"
        set slot 2 of {_gui} to bow named "&7Bow"
        set slot 3 of {_gui} to creeper spawn egg named "&2Creeper"
        set slot 4 of {_gui} to trident named "&3Trident"
        set slot 5 of {_gui} to elytra named "&bElytra"
        set slot 6 of {_gui} to diamond chestplate named "&9Diamond SMP"
        set slot 7 of {_gui} to diamond helmet named "&dDiamond Vanilla"
        set slot 8 of {_gui} to barrier named "&cExit"
        open {_gui} to player

on inventory click:
    if name of event-inventory is "&8Sub: Set MMR":
        cancel event
        if event-item is air:
            stop
        set {_n} to name of event-item
        if {_n} is "&6CartPVP":
            set {sub.setmmr.mode::%player%} to "cartpvp"
        else if {_n} is "&fSpeed":
            set {sub.setmmr.mode::%player%} to "speed"
        else if {_n} is "&7Bow":
            set {sub.setmmr.mode::%player%} to "bow"
        else if {_n} is "&2Creeper":
            set {sub.setmmr.mode::%player%} to "creeper"
        else if {_n} is "&3Trident":
            set {sub.setmmr.mode::%player%} to "trident"
        else if {_n} is "&bElytra":
            set {sub.setmmr.mode::%player%} to "elytra"
        else if {_n} is "&9Diamond SMP":
            set {sub.setmmr.mode::%player%} to "diamondsmp"
        else if {_n} is "&dDiamond Vanilla":
            set {sub.setmmr.mode::%player%} to "diamondvanilla"
        else:
            close player's inventory
            stop
        close player's inventory
        send "&8[&bSubSetMMR&8] &7Type the MMR amount in chat for &e%name of {sub.setmmr.target::%player%}%&7 in &f%{sub.setmmr.mode::%player%}%&7. Type &ccancel &7to abort." to player
        set {sub.setmmr.awaiting::%player%} to true

# ============================================================
#  ADMIN: /submmrreset <player> [mode]
# ============================================================
command /submmrreset <player> [<text>]:
    permission: op
    trigger:
        set {_uuid} to "%uuid of arg 1%"
        if arg 2 is set:
            set {sub.mmr.%arg-2%::%{_uuid}%} to 1000
            set {sub.fights.%arg-2%::%{_uuid}%} to 0
            delete {sub.mmr.lastfight.%arg-2%::%{_uuid}%}
            if {sub.ht1holder.%arg-2%} is {_uuid}:
                delete {sub.ht1holder.%arg-2%}
                send "&eHT1 throne for %arg-2% has been vacated." to player
            send "&aReset %name of arg 1%'s %arg-2% MMR to 1000 with 0 fights." to player
        else:
            loop "cartpvp", "speed", "bow", "creeper", "trident", "elytra", "diamondsmp", "diamondvanilla":
                set {sub.mmr.%loop-value%::%{_uuid}%} to 1000
                set {sub.fights.%loop-value%::%{_uuid}%} to 0
                delete {sub.mmr.lastfight.%loop-value%::%{_uuid}%}
                if {sub.ht1holder.%loop-value%} is {_uuid}:
                    delete {sub.ht1holder.%loop-value%}
            send "&aReset all sub MMR for %name of arg 1% to 1000 with 0 fights." to player

# ============================================================
#  ADMIN: /subdebuggmmr <player>
# ============================================================
command /subdebugmmr <player>:
    permission: op
    trigger:
        set {_uuid} to "%uuid of arg-1%"
        send "&eUUID: &f%{_uuid}%" to player
        loop "cartpvp", "speed", "bow", "creeper", "trident", "elytra", "diamondsmp", "diamondvanilla":
            set {_fights} to {sub.fights.%loop-value%::%{_uuid}%}
            set {_mmr}    to {sub.mmr.%loop-value%::%{_uuid}%}
            set {_placed} to subHasCompletedPlacements({_uuid}, loop-value)
            send "&7%loop-value%: &ffights=%{_fights}% mmr=%{_mmr}% placed=%{_placed}%" to player

# ============================================================
#  ADMIN: /subforceplacement <player> [mode]
# ============================================================
command /subforceplacement <offline player> [<text>]:
    permission: op
    trigger:
        set {_uuid} to "%uuid of arg-1%"
        if arg-2 is set:
            set {sub.fights.%arg-2%::%{_uuid}%} to 10
            send "&a[SubDuels] %name of arg-1% is now placed in %arg-2%." to player
        else:
            loop "cartpvp", "speed", "bow", "creeper", "trident", "elytra", "diamondsmp", "diamondvanilla":
                set {sub.fights.%loop-value%::%{_uuid}%} to 10
            send "&a[SubDuels] %name of arg-1% is now placed in all modes." to player

# ============================================================
#  ADMIN: /subfreearena <type> [number]
# ============================================================
command /subfreearena <text> [<integer>]:
    permission: op
    trigger:
        if arg-1 is "big":
            if arg-2 is set:
                delete {sub.arena.big.%arg-2%.inuse}
                send "&aFreed sub big arena %arg-2%." to player
            else:
                loop integers from 1 to 3:
                    delete {sub.arena.big.%loop-number%.inuse}
                send "&aFreed all sub big arenas." to player
        else:
            if arg-2 is set:
                delete {sub.arena.small.%arg-2%.inuse}
                send "&aFreed sub small arena %arg-2%." to player
            else:
                loop integers from 1 to 7:
                    delete {sub.arena.small.%loop-number%.inuse}
                send "&aFreed all sub small arenas." to player

# ============================================================
#  ADMIN: /subresetallstats
# ============================================================
command /subresetallstats:
    permission: op
    trigger:
        loop "cartpvp", "speed", "bow", "creeper", "trident", "elytra", "diamondsmp", "diamondvanilla":
            delete {sub.mmr.%loop-value%::*}
            delete {sub.fights.%loop-value%::*}
            delete {sub.wins.%loop-value%::*}
            delete {sub.losses.%loop-value%::*}
            delete {sub.mmr.lastfight.%loop-value%::*}
            delete {sub.ht1holder.%loop-value%}
        send "&a&l[SubDuels] All sub duel stats have been fully reset!" to player
        broadcast "&c&l[SubDuels] &7All sub ranked stats have been reset by &f%name of player%&7."

# ============================================================
#  QUEUE SYSTEM
# ============================================================

function subUpdateQueueSigns(mode: text):
    set {_count} to 0
    loop {sub.queue.players.%{_mode}%::*}:
        add 1 to {_count}
    set {_name} to subGetQueueModeName({_mode})
    loop {sub.queuesign.locs.%{_mode}%::*}:
        set {_loc} to loop-value
        set {_type} to type of block at {_loc}
        if {_type} is oak sign or spruce sign or birch sign or jungle sign or acacia sign or dark oak sign or crimson sign or warped sign or mangrove sign or bamboo sign or cherry sign:
            set line 1 of block at {_loc} to "&b&l%{_name}%"
            set line 2 of block at {_loc} to "&eSub Queue"
            set line 3 of block at {_loc} to "&f%{_count}% &7/ &f2"
            set line 4 of block at {_loc} to "&7[Click to join]"

function subLeaveAllQueues(p: player):
    set {_uuid} to "%uuid of {_p}%"
    loop "cartpvp", "speed", "bow", "creeper", "trident", "elytra", "diamondsmp", "diamondvanilla":
        if {sub.queue.players.%loop-value%::%{_uuid}%} is set:
            delete {sub.queue.players.%loop-value%::%{_uuid}%}
            call subUpdateQueueSigns(loop-value)
    delete {sub.queue.mode::%{_uuid}%}

function subJoinQueue(p: player, mode: text):
    set {_uuid} to "%uuid of {_p}%"

    if {sub.duel.active::%{_p}%} is true:
        send "{@prefix} &cYou are already in a sub duel." to {_p}
        stop
    if {duel.active::%{_p}%} is true:
        send "{@prefix} &cYou are already in a duel." to {_p}
        stop

    if {sub.queue.mode::%{_uuid}%} is set:
        set {_currentMode} to {sub.queue.mode::%{_uuid}%}
        if {_currentMode} is {_mode}:
            send "{@prefix} &cYou are already queued for &e%subGetQueueModeName({_mode})%&c." to {_p}
            stop
        delete {sub.queue.players.%{_currentMode}%::%{_uuid}%}
        call subUpdateQueueSigns({_currentMode})

    set {sub.queue.players.%{_mode}%::%{_uuid}%} to {_p}
    set {sub.queue.mode::%{_uuid}%} to {_mode}
    call subUpdateQueueSigns({_mode})

    send "{@prefix} &aJoined the &e%subGetQueueModeName({_mode})%&a sub queue! &7Waiting for an opponent..." to {_p}

    set {_count} to 0
    set {_other} to ""
    loop {sub.queue.players.%{_mode}%::*}:
        add 1 to {_count}
        if loop-index-1 is not {_uuid}:
            set {_other} to loop-index-1

    if {_count} >= 2:
        set {_p1} to {_p}
        set {_p2} to {sub.queue.players.%{_mode}%::%{_other}%}

        if {_p2} is not online:
            delete {sub.queue.players.%{_mode}%::%{_other}%}
            call subUpdateQueueSigns({_mode})
            send "{@prefix} &cMatched player went offline — still waiting..." to {_p1}
            stop

        set {_uuid2} to "%uuid of {_p2}%"
        delete {sub.queue.players.%{_mode}%::%{_uuid}%}
        delete {sub.queue.players.%{_mode}%::%{_uuid2}%}
        delete {sub.queue.mode::%{_uuid}%}
        delete {sub.queue.mode::%{_uuid2}%}
        call subUpdateQueueSigns({_mode})
        call subStartQueueDuel({_p1}, {_p2}, {_mode})

function subStartQueueDuel(p1: player, p2: player, mode: text):
    if {_mode} is "elytra" or "cartpvp" or "trident" or "diamondsmp" or "diamondvanilla" or "creeper":
        set {_arenaIdx} to subGetFreeBigArena()
        if {_arenaIdx} is 0:
            send "{@prefix} &cNo arenas available — re-queuing you both." to {_p1}
            send "{@prefix} &cNo arenas available — re-queuing you both." to {_p2}
            call subJoinQueue({_p1}, {_mode})
            call subJoinQueue({_p2}, {_mode})
            stop
        set {_arenaType} to "big"
        set {sub.arena.big.%{_arenaIdx}%.inuse} to true
        set {_spawnP1} to {sub.arena.big.%{_arenaIdx}%.p1}
        set {_spawnP2} to {sub.arena.big.%{_arenaIdx}%.p2}
    else:
        set {_arenaIdx} to subGetFreeSmallArena()
        if {_arenaIdx} is 0:
            send "{@prefix} &cNo arenas available — re-queuing you both." to {_p1}
            send "{@prefix} &cNo arenas available — re-queuing you both." to {_p2}
            call subJoinQueue({_p1}, {_mode})
            call subJoinQueue({_p2}, {_mode})
            stop
        set {_arenaType} to "small"
        set {sub.arena.small.%{_arenaIdx}%.inuse} to true
        set {_spawnP1} to {sub.arena.small.%{_arenaIdx}%.p1}
        set {_spawnP2} to {sub.arena.small.%{_arenaIdx}%.p2}

    set {_ft} to 2

    send "" to {_p1}
    send "&a&lMatch found! &eYou will face &f%name of {_p2}%&e in &6%subGetQueueModeName({_mode})%&e (FT%{_ft}%)." to {_p1}
    send "" to {_p1}
    send "" to {_p2}
    send "&a&lMatch found! &eYou will face &f%name of {_p1}%&e in &6%subGetQueueModeName({_mode})%&e (FT%{_ft}%)." to {_p2}
    send "" to {_p2}

    set {sub.duel.opponent::%{_p1}%}   to {_p2}
    set {sub.duel.opponent::%{_p2}%}   to {_p1}
    set {sub.duel.type::%{_p1}%}       to {_mode}
    set {sub.duel.type::%{_p2}%}       to {_mode}
    set {sub.duel.arena::%{_p1}%}      to {_arenaIdx}
    set {sub.duel.arena::%{_p2}%}      to {_arenaIdx}
    set {sub.duel.arenatype::%{_p1}%}  to {_arenaType}
    set {sub.duel.arenatype::%{_p2}%}  to {_arenaType}
    set {sub.duel.ft::%{_p1}%}         to {_ft}
    set {sub.duel.ft::%{_p2}%}         to {_ft}
    set {sub.duel.roundwins::%{_p1}%}  to 0
    set {sub.duel.roundwins::%{_p2}%}  to 0

    subSaveDuelState({_p1}, {_p2})
    subClearForDuel({_p1})
    subClearForDuel({_p2})

    teleport {_p1} to {_spawnP1}
    teleport {_p2} to {_spawnP2}

    if {_arenaType} is "big":
        resetBigArena({_arenaIdx})

    wait 5 ticks

    subGiveKitToPlayer({_p1}, {_mode})
    subGiveKitToPlayer({_p2}, {_mode})

    set {sub.duel.active::%{_p1}%} to true
    set {sub.duel.active::%{_p2}%} to true

    heal {_p1}
    heal {_p2}
    execute console command "effect clear %{_p1}%"
    execute console command "effect clear %{_p2}%"

    send "{@prefix} &aThe sub duel has started! &7(FT%{_ft}%) Use &e/subendduel &ato forfeit." to {_p1}
    send "{@prefix} &aThe sub duel has started! &7(FT%{_ft}%) Use &e/subendduel &ato forfeit." to {_p2}

# ============================================================
#  COMMAND: /subqueue
# ============================================================
command /subqueue:
    trigger:
        if {sub.duel.active::%player%} is true:
            send "{@prefix} &cYou are already in a sub duel." to player
            stop
        if {duel.active::%player%} is true:
            send "{@prefix} &cYou are already in a duel." to player
            stop

        set {_gui} to chest inventory with 2 rows named "&bSub: Join Queue"
        set slot 0  of {_gui} to minecart with tnt named "&6CartPVP"
        set slot 1  of {_gui} to diamond sword named "&fSpeed"
        set slot 2  of {_gui} to bow named "&7Bow"
        set slot 3  of {_gui} to creeper spawn egg named "&2Creeper"
        set slot 4  of {_gui} to trident named "&3Trident"
        set slot 5  of {_gui} to elytra named "&bElytra"
        set slot 6  of {_gui} to diamond chestplate named "&9Diamond SMP"
        set slot 7  of {_gui} to diamond helmet named "&dDiamond Vanilla"
        set slot 8  of {_gui} to barrier named "&cLeave Queue"
        open {_gui} to player

on inventory click:
    if name of event-inventory is "&bSub: Join Queue":
        cancel event
        if event-item is air:
            stop
        set {_n} to name of event-item
        set {_mode} to ""
        if {_n} is "&6CartPVP":
            set {_mode} to "cartpvp"
        else if {_n} is "&fSpeed":
            set {_mode} to "speed"
        else if {_n} is "&7Bow":
            set {_mode} to "bow"
        else if {_n} is "&2Creeper":
            set {_mode} to "creeper"
        else if {_n} is "&3Trident":
            set {_mode} to "trident"
        else if {_n} is "&bElytra":
            set {_mode} to "elytra"
        else if {_n} is "&9Diamond SMP":
            set {_mode} to "diamondsmp"
        else if {_n} is "&dDiamond Vanilla":
            set {_mode} to "diamondvanilla"
        else if {_n} is "&cLeave Queue":
            close player's inventory
            call subLeaveAllQueues(player)
            send "{@prefix} &cYou have left the sub queue." to player
            stop
        else:
            stop
        if {_mode} is "":
            stop
        close player's inventory
        call subJoinQueue(player, {_mode})

# ============================================================
#  COMMAND: /subleavequeue
# ============================================================
command /subleavequeue:
    trigger:
        set {_uuid} to "%uuid of player%"
        if {sub.queue.mode::%{_uuid}%} is not set:
            send "{@prefix} &cYou are not in any sub queue." to player
            stop
        call subLeaveAllQueues(player)
        send "{@prefix} &cYou have left the sub queue." to player

# ============================================================
#  COMMAND: /subsetsign <gamemode>
# ============================================================
command /subsetsign <text>:
    permission: op
    trigger:
        set {_mode} to arg-1
        if subIsValidQueueMode({_mode}) is false:
            send "{@prefix} &cInvalid mode. Use: cartpvp, speed, bow, creeper, trident, elytra, diamondsmp, diamondvanilla" to player
            stop
        set {_target} to target block of player
        set {_x} to round(x-coordinate of location of {_target})
        set {_y} to round(y-coordinate of location of {_target})
        set {_z} to round(z-coordinate of location of {_target})
        set {_w} to world of player
        set {_px} to round(x-coordinate of location of player)
        set {_pz} to round(z-coordinate of location of player)
        set {_dx} to {_x} - {_px}
        set {_dz} to {_z} - {_pz}
        set {_signx} to {_x}
        set {_signz} to {_z}
        if {_dx} > 0:
            set {_signx} to {_x} - 1
        else if {_dx} < 0:
            set {_signx} to {_x} + 1
        else if {_dz} > 0:
            set {_signz} to {_z} - 1
        else:
            set {_signz} to {_z} + 1
        set {_signloc} to location({_signx}, {_y}, {_signz}, {_w})
        set block at {_signloc} to oak sign
        set {_name} to subGetQueueModeName({_mode})
        set line 1 of block at {_signloc} to "&b&l%{_name}%"
        set line 2 of block at {_signloc} to "&eSub Queue"
        set line 3 of block at {_signloc} to "&f0 &7/ &f2"
        set line 4 of block at {_signloc} to "&7[Click to join]"
        set {_key} to "%{_signx}%_%{_y}%_%{_signz}%"
        set {sub.queuesign.locs.%{_mode}%::%{_key}%} to {_signloc}
        send "{@prefix} &aSub queue sign set for &e%{_name}%&a." to player

# ── SIGN CLICK ─────────────────────────────────────────────────
on right click on oak sign:
    2nd line of clicked block is "&eSub Queue"
    cancel event
    set {_line1} to line 1 of clicked block
    if {_line1} is "&b&lCartPVP":
        call subJoinQueue(player, "cartpvp")
    else if {_line1} is "&b&lSpeed":
        call subJoinQueue(player, "speed")
    else if {_line1} is "&b&lBow":
        call subJoinQueue(player, "bow")
    else if {_line1} is "&b&lCreeper":
        call subJoinQueue(player, "creeper")
    else if {_line1} is "&b&lTrident":
        call subJoinQueue(player, "trident")
    else if {_line1} is "&b&lElytra":
        call subJoinQueue(player, "elytra")
    else if {_line1} is "&b&lDiamond SMP":
        call subJoinQueue(player, "diamondsmp")
    else if {_line1} is "&b&lDiamond Vanilla":
        call subJoinQueue(player, "diamondvanilla")
    else:
        send "{@prefix} &cUnknown sub queue sign." to player

