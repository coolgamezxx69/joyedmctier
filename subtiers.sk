            set {_mode} to "elytra"
        else if {_n} is "&9Diamond SMP":
            set {_mode} to "diamondsmp"
        else if {_n} is "&dDiamond Vanilla":
            set {_mode} to "diamondvanilla"
        else:
            stop
        if {_mode} is "":
            stop
        delete {sub.editkit.inpicker::%player%}
        set {sub.editkit.editing::%player%} to {_mode}
        close player's inventory
        wait 1 tick
        call subOpenKitEditor(player, {_mode})

# ============================================================
#  KIT EDITOR GUI — 6 rows
#  Row 1 (slots 0-8):  controls
#  Rows 2-5 (9-44):    36 kit slots (inv slot N → gui slot N+9)
#  Row 6 (45-53):      glass panes
# ============================================================

function subOpenKitEditor(p: player, mode: text):
    set {_uuid}     to "%uuid of {_p}%"
    set {_modeName} to subGetQueueModeName({_mode})
    set {_gui}      to chest inventory with 6 rows named "&8Sub Edit: %{_modeName}%"
    set {_pane}     to gray stained glass pane named " "

    set slot 0 of {_gui} to lime dye named "&a&lSave Kit"  with lore "&7Saves your current layout."
    set slot 4 of {_gui} to red dye  named "&c&lReset Kit" with lore "&7Resets to the default kit."
    set slot 8 of {_gui} to barrier   named "&e&lClose"    with lore "&7Closes without saving."

    loop integers from 45 to 53:
        set slot loop-number of {_gui} to {_pane}

    set {_hasCustom} to subHasCustomKit({_uuid}, {_mode})
    if {_hasCustom} is false:
        set {_defaults::*} to subGetDefaultKitItems({_mode})

    loop integers from 0 to 35:
        set {_guiSlot} to loop-number + 9
        if {_hasCustom} is true:
            set {_item} to subGetCustomKitItem({_uuid}, {_mode}, loop-number)
        else:
            set {_item} to {_defaults::%loop-number + 1%}
            if {_item} is not set:
                set {_item} to air
        if {_item} is air:
            set slot {_guiSlot} of {_gui} to {_pane}
        else:
            set slot {_guiSlot} of {_gui} to {_item}

    open {_gui} to {_p}
    set {sub.editkit.editing::%{_p}%} to {_mode}

# ============================================================
#  KIT EDITOR CLICK — one handler catches all 8 mode GUIs
# ============================================================
on inventory click:
    if name of event-inventory starts with "&8Sub Edit:":
        set {_p}    to player
        set {_uuid} to "%uuid of {_p}%"
        set {_mode} to {sub.editkit.editing::%{_p}%}
        if {_mode} is not set:
            cancel event
            stop

        # Block player-inventory section and hotbar-swap
        if event-slot >= 54:
            cancel event
            stop
        if clicked inventory is player's inventory:
            cancel event
            stop
        if click action is number key:
            cancel event
            stop
        if click type is left mouse with shift:
            cancel event
            stop
        if click type is right mouse with shift:
            cancel event
            stop

        # Row 6 guard (slots 45-53)
        if event-slot >= 45:
            cancel event
            stop

        set {_n} to name of event-item

        if {_n} is "&a&lSave Kit":
            cancel event
            set {_paneCheck} to gray stained glass pane named " "
            loop integers from 0 to 35:
                set {_guiSlot} to loop-number + 9
                set {_item}    to slot {_guiSlot} of event-inventory
                if {_item} is {_paneCheck}:
                    set {sub.editkit.%{_mode}%.%{_uuid}%.%loop-number%} to air
                else:
                    set {sub.editkit.%{_mode}%.%{_uuid}%.%loop-number%} to {_item}
            set {sub.editkit.%{_mode}%.%{_uuid}%.hasCustom} to true
            close {_p}'s inventory
            delete {sub.editkit.editing::%{_p}%}
            send "{@prefix} &a&lKit saved! &7Your custom &e%subGetQueueModeName({_mode})%&7 kit is ready." to {_p}

        else if {_n} is "&c&lReset Kit":
            cancel event
            loop integers from 0 to 35:
                delete {sub.editkit.%{_mode}%.%{_uuid}%.%loop-number%}
            delete {sub.editkit.%{_mode}%.%{_uuid}%.hasCustom}
            close {_p}'s inventory
            delete {sub.editkit.editing::%{_p}%}
            wait 1 tick
            send "{@prefix} &c&lKit reset! &7Your &e%subGetQueueModeName({_mode})%&7 kit has been restored to default." to {_p}
            call subOpenKitEditor({_p}, {_mode})

        else if {_n} is "&e&lClose":
            cancel event
            close {_p}'s inventory
            delete {sub.editkit.editing::%{_p}%}
            send "{@prefix} &7Kit editor closed without saving." to {_p}

# ── Clean up on close ──────────────────────────────────────────
on inventory close:
    if name of event-inventory starts with "&8Sub Edit:":
        delete {sub.editkit.editing::%player%}
        delete {sub.editkit.inpicker::%player%}

# ── Prevent drops while editor open ───────────────────────────
on drop:
    if {sub.editkit.editing::%player%} is set:
        cancel event
        wait 1 tick
        remove event-item from player

# ============================================================
#  ADMIN: /subresetkit <player> [mode]
# ============================================================
command /subresetkit <offline player> [<text>]:
    permission: op
    trigger:
        set {_uuid} to "%uuid of arg-1%"
        if arg-2 is set:
            loop integers from 0 to 35:
                delete {sub.editkit.%arg-2%.%{_uuid}%.%loop-number%}
            delete {sub.editkit.%arg-2%.%{_uuid}%.hasCustom}
            send "&a[SubDuels] Reset %name of arg-1%'s custom %arg-2% kit." to player
        else:
            loop "cartpvp", "speed", "bow", "creeper", "trident", "elytra", "diamondsmp", "diamondvanilla":
                loop integers from 0 to 35:
                    delete {sub.editkit.%loop-value-1%.%{_uuid}%.%loop-value-2%}
                delete {sub.editkit.%loop-value-1%.%{_uuid}%.hasCustom}
            send "&a[SubDuels] Reset all custom kits for %name of arg-1%." to player