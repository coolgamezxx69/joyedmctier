options:
    prefix: &b&lSubDuels&b » 

# Subtiers → JoyedTiers API SYNC
# Add these functions to push sub-duel MMR/win/loss/HT1 data to the API
# after every match so the website leaderboard stays live.
# Set your API_BASE to your deployed API URL.
    API_BASE: https://api.joyedtiers.com/api

# Call this at the end of subApplyDuelMMR (after MMR is updated)
function subSyncMatchToAPI(winnerUUID: text, loserUUID: text, mode: text):
    set {_wMMR}   to {sub.mmr.%{_mode}%::%{_winnerUUID}%}
    set {_lMMR}   to {sub.mmr.%{_mode}%::%{_loserUUID}%}
    set {_wWins}  to {sub.wins.%{_mode}%::%{_winnerUUID}%}
    set {_lLoss}  to {sub.losses.%{_mode}%::%{_loserUUID}%}
    set {_wFight} to {sub.fights.%{_mode}%::%{_winnerUUID}%}
    set {_lFight} to {sub.fights.%{_mode}%::%{_loserUUID}%}

    # Sync winner
    set {_wBody} to "{""uuid"":""%{_winnerUUID}%"",""mode"":""%{_mode}%"",""mmr"":%{_wMMR}%,""wins"":%{_wWins}%,""losses"":{sub.losses.%{_mode}%::%{_winnerUUID}%},""fights"":%{_wFight}%}"
    make a POST request to "{@API_BASE}/sub-sync/stats" with headers "Content-Type: application/json" and body {_wBody}

    # Sync loser
    set {_lBody} to "{""uuid"":""%{_loserUUID}%"",""mode"":""%{_mode}%"",""mmr"":%{_lMMR}%,""wins"":{sub.wins.%{_mode}%::%{_loserUUID}%},""losses"":%{_lLoss}%,""fights"":%{_lFight}%}"
    make a POST request to "{@API_BASE}/sub-sync/stats" with headers "Content-Type: application/json" and body {_lBody}

# Call this when HT1 changes for a sub mode
function subSyncHT1ToAPI(newHolderUUID: text, mode: text):
    set {_body} to "{""uuid"":""%{_newHolderUUID}%"",""mode"":""%{_mode}%""}"
    make a POST request to "{@API_BASE}/sub-sync/ht1" with headers "Content-Type: application/json" and body {_body}


# ============================================================
#  SUB DUELS — Combined MMR + Kit system
#  Gamemodes: cartpvp, speed, bow, creeper, trident, elytra,
#             diamondsmp, diamondvanilla
#
#  Tier boundaries (MMR):
#  LT5 0-499 | HT5 500-899 | LT4 900-1299 | HT4 1300-1699
#  LT3 1700-2099 | HT3 2100-2499 | LT2 2500-2899 | HT2 2900-3299
#  LT1 3300-3699 | HT1 — held by defeating the current HT1
#
#  PLACEMENT  : 10 matches per gamemode before rank is shown
#  DECAY      : LT2+ players lose 25 MMR every 6h after 3 days idle
#  ROUNDS     : FT1–FT15, MMR applied only on series win
#  KIT EDITOR : /subeditkit — rearrange main-inventory slots per mode
# ============================================================

# ============================================================
#  MMR FUNCTIONS
# ============================================================

function subGetModeMMR(p: player, mode: text) :: number:
    set {_uuid} to "%uuid of {_p}%"
    if {sub.mmr.%{_mode}%::%{_uuid}%} is set:
        return {sub.mmr.%{_mode}%::%{_uuid}%}
    return 1000

function subGetModeFights(p: player, mode: text) :: number:
    set {_uuid} to "%uuid of {_p}%"
    if {sub.fights.%{_mode}%::%{_uuid}%} is set:
        return {sub.fights.%{_mode}%::%{_uuid}%}
    return 0

function subHasCompletedPlacements(uuid: text, mode: text) :: boolean:
    if {sub.fights.%{_mode}%::%{_uuid}%} is set:
        if {sub.fights.%{_mode}%::%{_uuid}%} >= 10:
            return true
    return false

function subTierFromMMR(mmr: number) :: text:
    if {_mmr} < 500:
        return "LT5"
    else if {_mmr} < 900:
        return "HT5"
    else if {_mmr} < 1300:
        return "LT4"
    else if {_mmr} < 1700:
        return "HT4"
    else if {_mmr} < 2100:
        return "LT3"
    else if {_mmr} < 2500:
        return "HT3"
    else if {_mmr} < 2900:
        return "LT2"
    else if {_mmr} < 3300:
        return "HT2"
    else:
        return "LT1"

function subGetModeRank(uuid: text, mode: text) :: text:
    if {sub.ht1holder.%{_mode}%} is {_uuid}:
        return "HT1"
    if subHasCompletedPlacements({_uuid}, {_mode}) is false:
        return "Unranked"
    if {sub.mmr.%{_mode}%::%{_uuid}%} is set:
        return subTierFromMMR({sub.mmr.%{_mode}%::%{_uuid}%})
    return subTierFromMMR(1000)

function subTierProgress(mmr: number, uuid: text, mode: text) :: number:
    if {sub.ht1holder.%{_mode}%} is {_uuid}:
        return 100
    if {_mmr} < 500:
        return round(({_mmr} / 500) * 100)
    else if {_mmr} < 900:
        return round((({_mmr} - 500) / 400) * 100)
    else if {_mmr} < 1300:
        return round((({_mmr} - 900) / 400) * 100)
    else if {_mmr} < 1700:
        return round((({_mmr} - 1300) / 400) * 100)
    else if {_mmr} < 2100:
        return round((({_mmr} - 1700) / 400) * 100)
    else if {_mmr} < 2500:
        return round((({_mmr} - 2100) / 400) * 100)
    else if {_mmr} < 2900:
        return round((({_mmr} - 2500) / 400) * 100)
    else if {_mmr} < 3300:
        return round((({_mmr} - 2900) / 400) * 100)
    else:
        return round((({_mmr} - 3300) / 400) * 100)

function subExpectedWin(mmrA: number, mmrB: number) :: number:
    set {_diff} to ({_mmrB} - {_mmrA}) / 400
    set {_pow} to 10 ^ {_diff}
    return 1.0 / (1.0 + {_pow})

function subCalcGain(winnerMMR: number, loserMMR: number, winnerFights: number) :: number:
    set {_k} to 120
    if {_winnerFights} < 10:
        set {_k} to 300
    set {_expected} to subExpectedWin({_winnerMMR}, {_loserMMR})
    return round({_k} * (1.0 - {_expected}))

function subCalcLoss(loserMMR: number, winnerMMR: number, loserFights: number) :: number:
    set {_k} to 120
    if {_loserFights} < 10:
        set {_k} to 300
    set {_expected} to subExpectedWin({_loserMMR}, {_winnerMMR})
    return round({_k} * {_expected})

function subApplyDuelMMR(winner: player, loser: player, mode: text):
    set {_wUUID} to "%uuid of {_winner}%"
    set {_lUUID} to "%uuid of {_loser}%"

    set {_wMMR}    to subGetModeMMR({_winner}, {_mode})
    set {_lMMR}    to subGetModeMMR({_loser},  {_mode})
    set {_wFights} to subGetModeFights({_winner}, {_mode})
    set {_lFights} to subGetModeFights({_loser},  {_mode})

    set {_gain} to subCalcGain({_wMMR}, {_lMMR}, {_wFights})
    set {_loss} to subCalcLoss({_lMMR}, {_wMMR}, {_lFights})

    set {_oldWRank} to subGetModeRank({_wUUID}, {_mode})
    set {_oldLRank} to subGetModeRank({_lUUID}, {_mode})

    set {_newWMMR} to min(9999, max(0, {_wMMR} + {_gain}))
    set {_newLMMR} to min(9999, max(0, {_lMMR} - {_loss}))

    set {sub.mmr.%{_mode}%::%{_wUUID}%} to {_newWMMR}
    set {sub.mmr.%{_mode}%::%{_lUUID}%} to {_newLMMR}

    set {sub.fights.%{_mode}%::%{_wUUID}%} to {_wFights} + 1
    set {sub.fights.%{_mode}%::%{_lUUID}%} to {_lFights} + 1

    if {sub.wins.%{_mode}%::%{_wUUID}%} is set:
        set {sub.wins.%{_mode}%::%{_wUUID}%} to {sub.wins.%{_mode}%::%{_wUUID}%} + 1
    else:
        set {sub.wins.%{_mode}%::%{_wUUID}%} to 1

    if {sub.losses.%{_mode}%::%{_lUUID}%} is set:
        set {sub.losses.%{_mode}%::%{_lUUID}%} to {sub.losses.%{_mode}%::%{_lUUID}%} + 1
    else:
        set {sub.losses.%{_mode}%::%{_lUUID}%} to 1

    set {sub.mmr.lastfight.%{_mode}%::%{_wUUID}%} to now
    set {sub.mmr.lastfight.%{_mode}%::%{_lUUID}%} to now

    set {_modeName} to subGetQueueModeName({_mode})

    # ── HT1 THRONE LOGIC ──────────────────────────────────────
    if {sub.ht1holder.%{_mode}%} is {_lUUID}:
        set {sub.ht1holder.%{_mode}%} to {_wUUID}
        set {sub.mmr.%{_mode}%::%{_lUUID}%} to 3300
        send "" to all players
        send "&6&l★ HT1 THRONE CHANGE [%{_modeName}%] ★" to all players
        send "&e%name of {_winner}% &7has dethroned &e%name of {_loser}%&7 in &6%{_modeName}%&7!" to all players
        send "&7%name of {_winner}% is now the sole &6&lHT1&7 in %{_modeName}%." to all players
        send "" to all players
        send "&c&lYou lost the HT1 throne in %{_modeName}% and have been placed into LT1." to {_loser}
        send "&a&lYou are now HT1 in %{_modeName}% — the best on the server!" to {_winner}
        stop

    if {sub.ht1holder.%{_mode}%} is not set:
        if {_newWMMR} >= 3700:
            if subHasCompletedPlacements({_wUUID}, {_mode}) is true:
                set {sub.ht1holder.%{_mode}%} to {_wUUID}
                set {sub.mmr.%{_mode}%::%{_wUUID}%} to 3700
                send "" to all players
                send "&6&l★ HT1 CROWNED [%{_modeName}%] ★" to all players
                send "&e%name of {_winner}% &7is the first ever &6&lHT1&7 in %{_modeName}%!" to all players
                send "" to all players

    # ── RANK FEEDBACK ─────────────────────────────────────────
    set {_newWRank}   to subGetModeRank({_wUUID}, {_mode})
    set {_newLRank}   to subGetModeRank({_lUUID}, {_mode})
    set {_wProgress}  to subTierProgress({_newWMMR}, {_wUUID}, {_mode})
    set {_lProgress}  to subTierProgress({_newLMMR}, {_lUUID}, {_mode})
    set {_wNewFights} to {_wFights} + 1
    set {_lNewFights} to {_lFights} + 1

    send "" to {_winner}
    send "&b&l[%{_modeName}% MMR]" to {_winner}
    if {_wNewFights} is 10:
        send "&a&lPlacements complete! Your starting rank is &6%{_newWRank}%&a in %{_modeName}%." to {_winner}
    else if {_wNewFights} < 10:
        send "&7Placement match &f%{_wNewFights}%&7/&f10 &7in %{_modeName}%" to {_winner}
    else:
        if {_newWRank} is not {_oldWRank}:
            if {_oldWRank} is "Unranked":
                send "&6&l▲ RANKED! &eYou are now &6%{_newWRank}%&e in %{_modeName}%!" to {_winner}
            else:
                send "&6&l▲ RANK UP! &eYou are now &6%{_newWRank}%&e in %{_modeName}%!" to {_winner}
        else:
            send "&7%{_modeName}% Rank: &f%{_newWRank}%" to {_winner}
        send "&7Progress: &f%{_wProgress}%&7%% through %{_newWRank}%" to {_winner}
    send "&a&l+%{_gain}% MMR &7(%{_newWMMR}% total in %{_modeName}%)" to {_winner}
    send "" to {_winner}

    send "" to {_loser}
    send "&b&l[%{_modeName}% MMR]" to {_loser}
    if {_lNewFights} is 10:
        send "&a&lPlacements complete! Your starting rank is &6%{_newLRank}%&a in %{_modeName}%." to {_loser}
    else if {_lNewFights} < 10:
        send "&7Placement match &f%{_lNewFights}%&7/&f10 &7in %{_modeName}%" to {_loser}
    else:
        if {_newLRank} is not {_oldLRank}:
            send "&4&l▼ RANK DOWN! &cYou are now &4%{_newLRank}%&c in %{_modeName}%." to {_loser}
        else:
            send "&7%{_modeName}% Rank: &f%{_newLRank}%" to {_loser}
        send "&7Progress: &f%{_lProgress}%&7%% through %{_newLRank}%" to {_loser}
    send "&c&l-%{_loss}% MMR &7(%{_newLMMR}% total in %{_modeName}%)" to {_loser}
    send "" to {_loser}

# ============================================================
#  MODE NAME + VALIDITY HELPERS
# ============================================================

function subGetQueueModeName(mode: text) :: text:
    if {_mode} is "cartpvp":
        return "CartPVP"
    if {_mode} is "speed":
        return "Speed"
    if {_mode} is "bow":
        return "Bow"
    if {_mode} is "creeper":
        return "Creeper"
    if {_mode} is "trident":
        return "Trident"
    if {_mode} is "elytra":
        return "Elytra"
    if {_mode} is "diamondsmp":
        return "Diamond SMP"
    if {_mode} is "diamondvanilla":
        return "Diamond Vanilla"
    return {_mode}

function subIsValidQueueMode(mode: text) :: boolean:
    loop "cartpvp", "speed", "bow", "creeper", "trident", "elytra", "diamondsmp", "diamondvanilla":
        if loop-value is {_mode}:
            return true
    return false

# ============================================================
#  TOTAL MMR / OVERALL RANK / POINTS
# ============================================================

function subGetTotalMMR(uuid: text) :: number:
    set {_total} to 0
    set {_rankedModes} to 0
    loop "cartpvp", "speed", "bow", "creeper", "trident", "elytra", "diamondsmp", "diamondvanilla":
        if subHasCompletedPlacements({_uuid}, loop-value) is true:
            if {sub.mmr.%loop-value%::%{_uuid}%} is set:
                add {sub.mmr.%loop-value%::%{_uuid}%} to {_total}
            else:
                add 1000 to {_total}
            add 1 to {_rankedModes}
    if {_rankedModes} is 0:
        return 0
    return {_total}

function subGetOverallRank(uuid: text) :: number:
    set {_myTotal} to subGetTotalMMR({_uuid})
    set {_pos} to 1
    loop "cartpvp", "speed", "bow", "creeper", "trident", "elytra", "diamondsmp", "diamondvanilla":
        loop {sub.mmr.%loop-value%::*}:
            set {_otherUUID} to loop-index-1
            if {_otherUUID} is not {_uuid}:
                if {_seen::%{_otherUUID}%} is not true:
                    set {_seen::%{_otherUUID}%} to true
                    if subGetTotalMMR({_otherUUID}) > {_myTotal}:
                        add 1 to {_pos}
    return {_pos}

function subGetPointsFromRank(rank: text) :: number:
    if {_rank} is "HT1":
        return 60
    else if {_rank} is "LT1":
        return 45
    else if {_rank} is "HT2":
        return 30
    else if {_rank} is "LT2":
        return 20
    else if {_rank} is "HT3":
        return 10
    else if {_rank} is "LT3":
        return 6
    else if {_rank} is "HT4":
        return 4
    else if {_rank} is "LT4":
        return 3
    else if {_rank} is "HT5":
        return 2
    else if {_rank} is "LT5":
        return 1
    return 0

function subGetTotalPoints(uuid: text) :: number:
    set {_total} to 0
    loop "cartpvp", "speed", "bow", "creeper", "trident", "elytra", "diamondsmp", "diamondvanilla":
        if subHasCompletedPlacements({_uuid}, loop-value) is true:
            set {_rank} to subGetModeRank({_uuid}, loop-value)
            add subGetPointsFromRank({_rank}) to {_total}
    return {_total}

# ============================================================
#  MMR DETERIORATION — every 6 hours
# ============================================================

every 6 hours:
    set {_decayAmount} to 25
    set {_decayFloor}  to 2500
    loop "cartpvp", "speed", "bow", "creeper", "trident", "elytra", "diamondsmp", "diamondvanilla":
        call subDecayMode(loop-value, {_decayAmount}, {_decayFloor})

function subDecayMode(mode: text, decayAmount: number, decayFloor: number):
    loop {sub.mmr.%{_mode}%::*}:
        set {_uuid} to loop-index-1
        set {_mmr}  to loop-value-1
        if {_mmr} >= {_decayFloor}:
            if {sub.mmr.lastfight.%{_mode}%::%{_uuid}%} is set:
                set {_lastFight} to {sub.mmr.lastfight.%{_mode}%::%{_uuid}%}
                if time since {_lastFight} > 3 days:
                    set {_newMMR} to max({_decayFloor}, {_mmr} - {_decayAmount})
                    set {sub.mmr.%{_mode}%::%{_uuid}%} to {_newMMR}
                    if {sub.ht1holder.%{_mode}%} is {_uuid}:
                        if {_newMMR} < 3300:
                            delete {sub.ht1holder.%{_mode}%}
                            loop all players:
                                if "%uuid of loop-player%" is {_uuid}:
                                    send "{@prefix} &cYour HT1 throne in &f%{_mode}%&c has been vacated due to inactivity." to loop-player
            else:
                set {sub.mmr.lastfight.%{_mode}%::%{_uuid}%} to now

# ============================================================
#  ARENA POOL — reuses same arena locations as main duels
# ============================================================

on load:
    set {sub.arena.small.1.p1} to location(-265, 103, -241, world("arena"))
    set {sub.arena.small.1.p2} to location(-359, 103, -241, world("arena"))
    set {sub.arena.small.2.p1} to location(-359, 103, -145, world("arena"))
    set {sub.arena.small.2.p2} to location(-265, 103, -144, world("arena"))
    set {sub.arena.small.3.p1} to location(-359, 103, -47, world("arena"))
    set {sub.arena.small.3.p2} to location(-265, 103, -48, world("arena"))
    set {sub.arena.small.4.p1} to location(-262, 103, -47, world("arena"))
    set {sub.arena.small.4.p2} to location(-168, 103, -47, world("arena"))
    set {sub.arena.small.5.p1} to location(-262, 103, -145, world("arena"))
    set {sub.arena.small.5.p2} to location(-168, 103, -144, world("arena"))
    set {sub.arena.small.6.p1} to location(-262, 103, -241, world("arena"))
    set {sub.arena.small.6.p2} to location(-168, 103, -241, world("arena"))
    set {sub.arena.small.7.p1} to location(-165, 103, -241, world("arena"))
    set {sub.arena.small.7.p2} to location(-71,  103, -241, world("arena"))
    set {sub.arena.big.1.p1} to location(81, 130, -339, world("arena"))
    set {sub.arena.big.1.p2} to location(6,  130, -339, world("arena"))
    set {sub.arena.big.2.p1} to location(81, 130, -391, world("arena"))
    set {sub.arena.big.2.p2} to location(6,  130, -394, world("arena"))
    set {sub.arena.big.3.p1} to location(81, 130, -449, world("arena"))
    set {sub.arena.big.3.p2} to location(6,  130, -454, world("arena"))

function subGetFreeSmallArena() :: number:
    loop integers from 1 to 7:
        if {sub.arena.small.%loop-number%.inuse} is not true:
            return loop-number
    return 0

function subGetFreeBigArena() :: number:
    loop integers from 1 to 3:
        if {sub.arena.big.%loop-number%.inuse} is not true:
            return loop-number
    return 0

# ============================================================
#  INVENTORY SAVE / RESTORE HELPERS
# ============================================================

function subSaveDuelState(p1: player, p2: player):
    loop 36 times:
        set {sub.saved.inv.%{_p1}%.%loop-number - 1%} to slot (loop-number - 1) of {_p1}'s inventory
    set {sub.saved.armor.helmet::%{_p1}%}     to {_p1}'s helmet
    set {sub.saved.armor.chestplate::%{_p1}%} to {_p1}'s chestplate
    set {sub.saved.armor.leggings::%{_p1}%}   to {_p1}'s leggings
    set {sub.saved.armor.boots::%{_p1}%}      to {_p1}'s boots
    set {sub.saved.armor.offhand::%{_p1}%}    to {_p1}'s offhand tool
    set {sub.duel.pos::%{_p1}%}               to location of {_p1}
    loop 36 times:
        set {sub.saved.inv.%{_p2}%.%loop-number - 1%} to slot (loop-number - 1) of {_p2}'s inventory
    set {sub.saved.armor.helmet::%{_p2}%}     to {_p2}'s helmet
    set {sub.saved.armor.chestplate::%{_p2}%} to {_p2}'s chestplate
    set {sub.saved.armor.leggings::%{_p2}%}   to {_p2}'s leggings
    set {sub.saved.armor.boots::%{_p2}%}      to {_p2}'s boots
    set {sub.saved.armor.offhand::%{_p2}%}    to {_p2}'s offhand tool
    set {sub.duel.pos::%{_p2}%}               to location of {_p2}

function subClearForDuel(p: player):
    clear {_p}'s inventory
    set {_p}'s helmet      to air
    set {_p}'s chestplate  to air
    set {_p}'s leggings    to air
    set {_p}'s boots       to air
    set {_p}'s offhand tool to air

function subRestorePlayer(p: player):
    clear {_p}'s inventory
    set {_p}'s helmet      to air
    set {_p}'s chestplate  to air
    set {_p}'s leggings    to air
    set {_p}'s boots       to air
    set {_p}'s offhand tool to air
    loop 36 times:
        set slot (loop-number - 1) of {_p}'s inventory to {sub.saved.inv.%{_p}%.%loop-number - 1%}
    delete {sub.saved.inv.%{_p}%::*}
    set {_p}'s helmet      to {sub.saved.armor.helmet::%{_p}%}
    set {_p}'s chestplate  to {sub.saved.armor.chestplate::%{_p}%}
    set {_p}'s leggings    to {sub.saved.armor.leggings::%{_p}%}
    set {_p}'s boots       to {sub.saved.armor.boots::%{_p}%}
    set {_p}'s offhand tool to {sub.saved.armor.offhand::%{_p}%}
    delete {sub.saved.armor.helmet::%{_p}%}
    delete {sub.saved.armor.chestplate::%{_p}%}
    delete {sub.saved.armor.leggings::%{_p}%}
    delete {sub.saved.armor.boots::%{_p}%}
    delete {sub.saved.armor.offhand::%{_p}%}
    teleport {_p} to {sub.duel.pos::%{_p}%}
    delete {sub.duel.pos::%{_p}%}

function subCleanDuelVars(p: player):
    delete {sub.duel.active::%{_p}%}
    delete {sub.duel.opponent::%{_p}%}
    delete {sub.duel.type::%{_p}%}
    delete {sub.duel.arena::%{_p}%}
    delete {sub.duel.arenatype::%{_p}%}

function subCleanRoundVars(p: player):
    delete {sub.duel.roundwins::%{_p}%}
    delete {sub.duel.ft::%{_p}%}
    delete {sub.duel.inroundbreak::%{_p}%}

# ============================================================
#  DEFAULT KIT ITEMS (slot 0-35, 1-indexed list)
#  Used by kit editor to populate the editor GUI and as
#  fallback when no custom kit is saved.
# ============================================================

function subGetDefaultKitItems(mode: text) :: objects:
    # 36-slot list, index 1 = inv slot 0
    set {_items::*} to (air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air, air)

    if {_mode} is "cartpvp":
        set {_items::1}  to 64 of arrow
        set {_items::2}  to 16 of ender pearl
        set {_items::3}  to minecart with tnt
