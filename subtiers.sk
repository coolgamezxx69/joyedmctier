# ============================================================
#  ARMOUR HELPER — applies default armour + offhand per mode
# ============================================================

function subApplyDefaultArmourAndOffhand(p: player, mode: text):
    if {_mode} is "cartpvp":
        set {_p}'s helmet     to netherite helmet of protection 4, unbreaking 3, mending
        set {_p}'s chestplate to netherite chestplate of protection 4, unbreaking 3, mending
        set {_p}'s leggings   to netherite leggings of protection 4, unbreaking 3, mending
        set {_p}'s boots      to netherite boots of protection 4, unbreaking 3, mending
        set {_p}'s offhand tool to totem of undying

    else if {_mode} is "speed":
        set {_p}'s helmet     to diamond helmet of protection 4
        set {_p}'s chestplate to diamond chestplate of protection 4
        set {_p}'s leggings   to iron leggings of protection 4
        set {_p}'s boots      to diamond boots of protection 4
        apply speed 2 to {_p} for 99999 seconds

    else if {_mode} is "bow":
        set {_p}'s helmet     to iron helmet of protection 4
        set {_p}'s chestplate to iron chestplate of protection 4
        set {_p}'s leggings   to iron leggings of protection 4
        set {_p}'s boots      to iron boots of protection 4

    else if {_mode} is "creeper":
        set {_p}'s helmet     to chainmail helmet of protection 4
        set {_p}'s chestplate to chainmail chestplate of protection 4
        set {_p}'s leggings   to chainmail leggings of protection 4
        set {_p}'s boots      to chainmail boots of protection 4
        set {_p}'s offhand tool to shield

    else if {_mode} is "trident":
        set {_p}'s helmet     to turtle helmet of protection 4, unbreaking 3, mending
        set {_p}'s chestplate to golden chestplate of protection 4, unbreaking 3, mending
        set {_p}'s leggings   to golden leggings of protection 4, unbreaking 3, mending
        set {_p}'s boots      to golden boots of protection 4, unbreaking 3, mending, depth strider 3
        set {_p}'s offhand tool to totem of undying

    else if {_mode} is "elytra":
        set {_p}'s helmet     to netherite helmet of protection 4, unbreaking 3, mending
        set {_p}'s chestplate to air
        set {_p}'s leggings   to air
        set {_p}'s boots      to air
        set {_p}'s offhand tool to totem of undying

    else if {_mode} is "diamondsmp":
        set {_p}'s helmet     to netherite helmet of protection 4, unbreaking 3, mending
        set {_p}'s chestplate to netherite chestplate of protection 4, unbreaking 3, mending
        set {_p}'s leggings   to netherite leggings of protection 4, unbreaking 3, mending
        set {_p}'s boots      to netherite boots of protection 4, unbreaking 3, mending
        set {_shield} to shield
        enchant {_shield} with unbreaking 3
        enchant {_shield} with mending 1
        set {_p}'s offhand tool to {_shield}

    else if {_mode} is "diamondvanilla":
        set {_p}'s helmet     to diamond helmet of protection 4, unbreaking 3
        set {_p}'s chestplate to diamond chestplate of protection 4, unbreaking 3
        set {_p}'s leggings   to diamond leggings of protection 4, unbreaking 3
        set {_p}'s boots      to diamond boots of protection 4, unbreaking 3
        set {_p}'s offhand tool to totem of undying

# ============================================================
#  GIVE KIT — default (set slot) + armour
# ============================================================

# ============================================================
#  GIVE KIT — writes directly to inventory, no list passing
# ============================================================

function subGiveKit(p: player, mode: text):
    subClearForDuel({_p})
    subWriteDefaultKitToPlayer({_p}, {_mode})
    subApplyDefaultArmourAndOffhand({_p}, {_mode})

function subWriteDefaultKitToPlayer(p: player, mode: text):
