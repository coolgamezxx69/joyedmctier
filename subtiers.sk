        set slot 20 of {_gui} to elytra named "&bElytra"
        set slot 21 of {_gui} to diamond chestplate named "&9Diamond SMP"
        set slot 22 of {_gui} to diamond helmet named "&dDiamond Vanilla"

        open {_gui} to player
